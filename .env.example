# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Django core ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ─────────────────────────────────────────────────────────
# MySQL example:
DB_ENGINE=django.db.backends.mysql
DB_NAME=tool
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=mydb
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_HOST=localhost
# DB_PORT=5432

# SQLite (default fallback — leave DB_ENGINE blank):
# DB_ENGINE=

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
# Get credentials from: https://www.linkedin.com/developers/apps
#
# Register this EXACT URL in LinkedIn App → Auth → Authorized redirect URLs:
#   LOCAL:      http://127.0.0.1:8000/posts/social-accounts/linkedin/callback/
#   PRODUCTION: https://yourdomain.com/posts/social-accounts/linkedin/callback/
#
# Required scopes (LinkedIn App → Products → Share on LinkedIn):
#   openid, profile, email, w_member_social

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/posts/social-accounts/linkedin/callback/
